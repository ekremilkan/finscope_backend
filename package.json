{
  "name": "finscope_back",
  "version": "2.0.0",
  "description": "Enterprise-level finansal uygulama backend servisi - Node.js, Express.js, MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "nodemon server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:db": "node tests/db-connection-test.js",
    "segments:recompute": "node scripts/segments.recompute.js --chain=ethereum --period=90d --mode=zscore",
    "segments:cron": "node scripts/segments.cron.js"
  },
  "keywords": [
    "fintech",
    "api",
    "nodejs",
    "express",
    "mongodb",
    "jwt",
    "authentication",
    "security",
    "backend"
  ],
  "author": {
    "name": "Ekrem İlkan",
    "email": "contact@example.com"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/ekremilkan/finscope_backend.git"
  },
  "bugs": {
    "url": "https://github.com/ekremilkan/finscope_backend/issues"
  },
  "homepage": "https://github.com/ekremilkan/finscope_backend#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@solana/web3.js": "^1.87.6",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "bs58": "^5.0.0",
    "chartjs-node-canvas": "^5.0.0",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.5.0",
    "ethers": "^5.8.0",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "input": "^1.0.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.3",
    "nodemon": "^3.1.10",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22",
    "tronweb": "^5.3.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^30.0.2",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "services/**/*.js",
      "models/**/*.js",
      "middlewares/**/*.js",
      "utils/**/*.js",
      "!**/node_modules/**",
      "!**/tests/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageDirectory": "coverage",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
